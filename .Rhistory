require(knitr) #for qmd building
require(gapminder) #for plot aesthetics
## ---- loaddata --------
data_location1 <- "Data/Processed_data/Analysis1/output.rds"
d1 <- readRDS(data_location1)
data_location2 <- "Data/Processed_data/Analysis1/Coords.rds"
Coords <- readRDS(data_location2)
data_location3 <- "Data/Processed_data/Analysis1/gpa.rds"
d1array.gpa <- readRDS(data_location3)
data_location4 <- "Data/Processed_data/Analysis1/SMlog.rds"
SMlog <- readRDS(data_location4)
data_location5 <- "Data/Processed_data/Analysis1/PD.rds"
PD <- readRDS(data_location5)
###Work in progress####
## ---- PCA -------
par(mar=c(1,1,1,1))
d1.pca<-gm.prcomp(d1array.gpa$coords)
d1.pca
plot(d1.pca)
SlicerMorph.MS <- read.table(file = paste(SMlog$output.path,
SMlog$MeanShape,
sep="/"),
sep=",", header = TRUE, row.names=1)
plot(d1.pca, main = "PCA by Sex",
col=d1$Sex,
pch=16
)
legend("bottomright", pch = 20, col=unique(d1$Sex), legend = unique(d1$Sex))
plot(d1.pca, main = "PCA by Ancestry",
col=d1$Ancestry,
pch=16)
legend("bottomright", pch = 20, col=unique(d1$Ancestry), legend = unique(d1$Ancestry))
## ---- fourplot -------
par(mfrow= c(2,2))
plot(d1.pca, main = "PCA",
col=d1$Ancestry,
pch=16)
legend("topright", pch = 20, col=unique(d1$Ancestry), legend = unique(d1$Ancestry))
plot(d1.pca, main = "PCA",
axis1=1, axis2=3,
col=d1$Ancestry,
pch=16
)
plot(d1.pca, main = "PCA",
axis1=2, axis2=3,
col=d1$Ancestry,
pch=16
)
plot(d1.pca, main = "PCA",
axis1=3, axis2=4,
col=d1$Ancestry,
pch=16
)
## ---- gdf -------
gdf <- geomorph.data.frame(PD,
Ancestry = d1$Ancestry,
Sex = d1$Sex,
Csize = d1$centroid)
attributes(gdf)
lm.fit <- procD.lm(Coords~Ancestry*Sex, data=gdf)
summary(lm.fit)
plot(lm.fit)
anova(procD.lm(Coords~Csize + Ancestry*Sex, data=gdf))
# 1. Build the data frame using PD directly for coords
gdf <- geomorph.data.frame(coords = PD,
Ancestry = d1$Ancestry,
Sex = d1$Sex,
Csize = d1$centroid)
# 2. Run the shape disparity test for Ancestry
shape_disp_ancestry <- morphol.disparity(coords ~ Ancestry,
groups = ~ Ancestry,
data = gdf,
iter = 999)
# 3. View the results
summary(shape_disp_ancestry)
# 1. Calculate the morphological variance (disparity) within Ancestry groups
# This ignores Sex to look at the overall variance per Ancestry
ancestry_variance <- morphol.disparity(
Coords ~ Ancestry,
groups = ~ Ancestry,
data = gdf,
iter = 999
)
# 2. View the statistical table and pairwise P-values in your console
summary(ancestry_variance)
# 3. Extract the variance vector
ancestry_vars <- ancestry_variance$Procrustes.var
# 4. Generate the barplot for Ancestry
par(mar = c(8, 4, 3, 1)) # Margins adjusted for Ancestry labels
barplot(
ancestry_vars,
col = "tomato",          # Different color to distinguish from the interaction plot
las = 2,                 # Rotates text labels vertically
main = "Morphological Disparity by Ancestry",
ylab = "Procrustes Variance"
)
## ---- Morphological Disparity Analysis & Plot -------
# 1. Calculate the morphological variance (disparity) within each group
morph_variance <- morphol.disparity(
Coords ~ Ancestry * Sex,
groups = ~ interaction(Ancestry, Sex),
data = gdf,
iter = 999
)
# 2. View the complete statistics table in your console
summary(morph_variance)
# 3. FIX: Extract the variance vector (it already contains the correct names!)
group_variances <- morph_variance$Procrustes.var
# 4. Generate your barplot directly without assigning manual names
par(mar = c(10, 4, 3, 1)) # Increase bottom margin to ensure long group names fit
barplot(
group_variances,
col = "skyblue",
las = 2,                 # Rotates text labels vertically so they don't overlap
main = "Morphological Disparity by Group",
ylab = "Procrustes Variance"
)
## ---- Morphological Disparity by Ancestry -------
# 1. Calculate the morphological variance (disparity) within Ancestry groups
ancestry_variance <- morphol.disparity(
Coords ~ Ancestry,
groups = ~ Ancestry,
data = gdf,
iter = 999
)
# 2. FIX: Capture and hide the progress text while printing the table
invisible(capture.output(summary_table <- summary(ancestry_variance)))
print(summary_table)
# 3. Extract the variance vector
ancestry_vars <- ancestry_variance$Procrustes.var
# 4. Generate the barplot for Ancestry
par(mar = c(8, 4, 3, 1))
barplot(
ancestry_vars,
col = "tomato",
las = 2,
main = "Morphological Disparity by Ancestry",
ylab = "Procrustes Variance"
)
## ---- Format Disparity Tables for Quarto -------
# 1. Capture the summary object safely without the progress text
invisible(capture.output(summary_table <- summary(ancestry_variance)))
# 2. CREATE TABLE 1: Procrustes Variances per Ancestry Group
variance_df <- data.frame(
Ancestry = names(summary_table$Procrustes.var),
`Procrustes Variance` = as.numeric(summary_table$Procrustes.var)
)
kable(
variance_df,
caption = "Morphological Disparity (Procrustes Variance) by Ancestry Group",
digits = 6,
align = "lc"
)
# 3. CREATE TABLE 2: Pairwise P-Values Matrix
# This pulls the exact statistical matrix calculated by geomorph
p_matrix <- summary_table$pairwise.P.values
kable(
p_matrix,
caption = "Pairwise P-Values for Differences in Morphological Disparity (Alpha = 0.05)",
digits = 4,
align = "c"
)
## ---- Format Disparity Tables for Quarto -------
# 1. Capture the summary object safely without the progress text
invisible(capture.output(summary_table <- summary(ancestry_variance)))
# 2. CREATE TABLE 1: Procrustes Variances per Ancestry Group
variance_df <- data.frame(
Ancestry = names(summary_table$Procrustes.var),
`Procrustes Variance` = as.numeric(summary_table$Procrustes.var)
)
knitr::kable(
variance_df,
caption = "Morphological Disparity (Procrustes Variance) by Ancestry Group",
digits = 6,
align = "lc"
)
# 3. FIX: Extract the exact lowercase matrix element name ($pairwise.p.values)
p_matrix <- summary_table$pairwise.p.values
# 4. Clean up the matrix layout for markdown rendering
# This replaces the redundant matching upper half of the table with blanks
p_matrix[upper.tri(p_matrix, diag = TRUE)] <- ""
## ---- Format Disparity Tables for Quarto -------
# 1. Capture and print the console summary safely
invisible(capture.output(summary_table <- summary(ancestry_variance)))
# 2. CREATE TABLE 1: Procrustes Variances per Ancestry Group
variance_df <- data.frame(
Ancestry = names(ancestry_variance$Procrustes.var),
`Procrustes Variance` = as.numeric(ancestry_variance$Procrustes.var)
)
knitr::kable(
variance_df,
caption = "Morphological Disparity (Procrustes Variance) by Ancestry Group",
digits = 6,
align = "lc"
)
# 3. CRITICAL FIX: Extract the raw matrix directly from the main object
p_matrix <- ancestry_variance$PV.dist.matrix
# 4. Clean up the matrix layout for markdown rendering
# This drops the redundant duplicate upper triangle safely
p_matrix[upper.tri(p_matrix, diag = TRUE)] <- ""
## ---- Format Disparity Tables for Quarto -------
# 1. Capture the console summary safely
invisible(capture.output(summary_table <- summary(ancestry_variance)))
# 2. CREATE TABLE 1: Procrustes Variances per Ancestry Group
variance_df <- data.frame(
Ancestry = names(ancestry_variance$Procrustes.var),
`Procrustes Variance` = as.numeric(ancestry_variance$Procrustes.var)
)
knitr::kable(
variance_df,
caption = "Morphological Disparity (Procrustes Variance) by Ancestry Group",
digits = 6,
align = "lc"
)
# 3. CRITICAL FIX: Extract the actual underlying pairwise p-value matrix from RRPP
# We use as.matrix() on the distance matrix elements stored inside the object
p_matrix <- as.matrix(ancestry_variance$PV.dist.p.values)
## ---- Format Disparity Tables for Quarto -------
# 1. Capture the exact text that summary normally prints to your screen
summary_text <- capture.output(summary(ancestry_variance))
# 2. CREATE TABLE 1: Procrustes Variances per Ancestry Group
variance_df <- data.frame(
Ancestry = names(ancestry_variance$Procrustes.var),
`Procrustes Variance` = as.numeric(ancestry_variance$Procrustes.var)
)
knitr::kable(
variance_df,
caption = "Morphological Disparity (Procrustes Variance) by Ancestry Group",
digits = 6,
align = "lc"
)
# 3. CRITICAL FIX: Extract and parse the Pairwise P-Value text block dynamically
# Find where the P-value table begins and ends in the console text output
p_start <- grep("Pairwise p-values", summary_text)
if(length(p_start) > 0) {
# Isolate just the rows containing the table data
p_table_text <- summary_text[(p_start + 1):length(summary_text)]
p_table_text <- p_table_text[p_table_text != ""] # Strip blank spacing lines
# Read the text block into a clean, standard R Data Frame
p_table <- read.table(text = p_table_text, header = TRUE, row.names = 1, check.names = FALSE)
# Clean up the matrix layout for markdown rendering (remove the matching upper half)
p_matrix <- as.matrix(p_table)
p_matrix[upper.tri(p_matrix, diag = TRUE)] <- ""
p_table_clean <- as.data.frame(p_matrix)
# 4. CREATE TABLE 2: Pairwise P-Values Matrix
knitr::kable(
p_table_clean,
caption = "Pairwise P-Values for Differences in Morphological Disparity (Alpha = 0.05)",
align = "c"
)
} else {
cat("Pairwise comparisons could not be parsed.")
}
## ---- Format Disparity Tables for Quarto -------
# 1. Capture the exact text that summary normally prints to your screen
summary_text <- capture.output(summary(ancestry_variance))
# 2. CREATE TABLE 1: Procrustes Variances per Ancestry Group
variance_df <- data.frame(
Ancestry = names(ancestry_variance$Procrustes.var),
`Procrustes Variance` = as.numeric(ancestry_variance$Procrustes.var)
)
knitr::kable(
variance_df,
caption = "Morphological Disparity (Procrustes Variance) by Ancestry Group",
digits = 6,
align = "lc"
)
# 3. CRITICAL FIX: Dynamically separate the two printed tables by finding empty lines
# Filter out empty or space-only lines from the captured text
clean_lines <- summary_text[trimws(summary_text) != ""]
# Find where the second data table starts (usually after the variance vector printout)
# We find rows that start with a common character or standard table header block
table_lines <- clean_lines[grep("^[[:alnum:]_.]", clean_lines)]
# Find the line that lists all of your ancestry groups as space-separated columns
header_index <- grep(names(ancestry_variance$Procrustes.var)[1], table_lines)[1]
if (!is.na(header_index) && header_index <= length(table_lines)) {
# Isolate only the rows containing the pairwise table matrix data
raw_matrix_lines <- table_lines[header_index:length(table_lines)]
# Read the text block into a clean, standard R Data Frame
p_table <- read.table(text = raw_matrix_lines, header = TRUE, row.names = 1, check.names = FALSE)
# Clean up the matrix layout for markdown rendering (remove the matching upper half)
p_matrix <- as.matrix(p_table)
p_matrix[upper.tri(p_matrix, diag = TRUE)] <- ""
p_table_clean <- as.data.frame(p_matrix)
# 4. CREATE TABLE 2: Pairwise P-Values Matrix
knitr::kable(
p_table_clean,
caption = "Pairwise P-Values for Differences in Morphological Disparity (Alpha = 0.05)",
align = "c"
)
} else {
# Fallback: if text cleaning fails, cleanly dump the raw pairwise string data
cat("### Pairwise Statistical Summary Matrix\n")
cat("```\n")
cat(summary_text, sep = "\n")
cat("\n```")
}
## ---- Format Disparity Tables for Quarto -------
# 1. Capture the summary object safely
summary_table <- summary(ancestry_variance)
# 2. CREATE TABLE 1: Procrustes Variances per Ancestry Group
variance_df <- data.frame(
Ancestry = names(ancestry_variance$Procrustes.var),
`Procrustes Variance` = as.numeric(ancestry_variance$Procrustes.var)
)
knitr::kable(
variance_df,
caption = "Morphological Disparity (Procrustes Variance) by Ancestry Group",
digits = 6,
align = "lc"
)
# 3. CRITICAL FIX: Extract the P-values matrix using RRPP's native reveal.matrix function
# This safely pulls the actual statistical grid without any string-parsing errors
p_matrix <- reveal.matrix(summary_table, as.matrix = TRUE, matrix.type = "p.values")
## ---- Format Disparity Tables for Quarto -------
# 1. Capture the console summary text to hide the progress statement
invisible(capture.output(summary_table <- summary(ancestry_variance)))
# 2. CREATE TABLE 1: Procrustes Variances per Ancestry Group
variance_df <- data.frame(
Ancestry = names(ancestry_variance$Procrustes.var),
`Procrustes Variance` = as.numeric(ancestry_variance$Procrustes.var)
)
knitr::kable(
variance_df,
caption = "Morphological Disparity (Procrustes Variance) by Ancestry Group",
digits = 6,
align = "lc"
)
# 3. CRITICAL FIX: Pull the pairwise P-values matrix straight from the source object
p_matrix <- ancestry_variance$PV.dist.Pval
# 4. Clean up the matrix layout for markdown rendering
# This drops the redundant duplicate upper triangle safely
p_matrix[upper.tri(p_matrix, diag = TRUE)] <- ""
p_table_clean <- as.data.frame(p_matrix)
# 5. CREATE TABLE 2: Pairwise P-Values Matrix
knitr::kable(
p_table_clean,
caption = "Pairwise P-Values for Differences in Morphological Disparity (Alpha = 0.05)",
align = "c"
)
